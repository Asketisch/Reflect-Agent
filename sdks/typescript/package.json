{
  "name": "zhuye",
  "version": "0.1.0",
  "description": "ZhuYe Agent SDK for TypeScript: spawn `zhuye serve` and drive it over JSONL stdio.",
  "author": "ZhuYe Agent Contributors",
  "homepage": "https://github.com/Asketisch/ZhuYe#readme",
  "repository": {
